# Cart Platform — example environment. Copy to .env and edit.
# NEVER commit real secrets.

# ---------------------------------------------------------------- ML server
CART_PLATFORM_HOST=127.0.0.1
CART_PLATFORM_PORT=8100
CART_PLATFORM_DB=./data/platform.db
CART_PLATFORM_UPLOAD_DIR=./data/uploads
CART_PLATFORM_LOG_DIR=./logs

# Bearer token for upload/train/promote/score/artifact routes.
# Leave unset for local development (auth disabled).
# CART_PLATFORM_API_TOKEN=change-me-ml-server

# Entity identity. Set to 1 only if DVR ids restart per store, which makes the
# entity key site-scoped ("163:215:0") and enables the site-scoped score route.
CART_ENTITY_INCLUDE_SITE=0

# Scoring history window. 10 is the hard feature floor, 12 enforced, 20 advised.
CART_MIN_HISTORY=12

# Trainability floors — below these a stream is reported INSUFFICIENT_TRAINING_DATA
CART_MIN_TRAIN_RECORDS=200
CART_MIN_TRAIN_DAYS=2
CART_MIN_HOLDOUT_RECORDS=40
CART_MIN_CALIBRATION_SAMPLES=50
CART_MIN_CALIBRATION_POSITIVES=5

# Chronological split (remainder is the backtest holdout)
CART_TRAIN_FRACTION=0.6
CART_CALIBRATION_FRACTION=0.2

# Upload limits
CART_MAX_UPLOAD_BYTES=268435456

# ------------------------------------------------------- Result receiver (P7)
CART_RECEIVER_HOST=127.0.0.1
CART_RECEIVER_PORT=8200
CART_RECEIVER_DB=./data/results_receiver.db

# Publishing from the ML server to the receiver
CART_RESULT_RECEIVER_URL=http://127.0.0.1:8200
CART_RESULT_RECEIVER_ENABLED=1
CART_RESULT_PUBLISH_TIMEOUT_SEC=10
CART_RESULT_PUBLISH_MAX_ATTEMPTS=8
CART_RESULT_PUBLISH_BACKOFF_SEC=2
CART_RESULT_PUBLISH_MAX_BACKOFF_SEC=300
CART_RESULT_WORKER_INTERVAL_SEC=5

# Bearer token required by the receiver for writes. Must match on both sides.
# CART_RESULT_RECEIVER_TOKEN=change-me-receiver
