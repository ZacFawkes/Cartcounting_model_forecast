{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://127.0.0.1:8300",
  "Publisher": {
    "ConnectionString": "",
    "Schema": "cart",
    "ReceiverUrl": "http://127.0.0.1:8200",
    "Token": "",
    "Enabled": true,
    "TimeoutSeconds": 10,
    "MaxAttempts": 8,
    "BaseBackoffSeconds": 2,
    "MaxBackoffSeconds": 300,
    "WorkerIntervalSeconds": 5,
    "BatchSize": 20,
    "StuckAfterSeconds": 120,
    "RunWorker": true
  }
}
