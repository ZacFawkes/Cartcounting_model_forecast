### Cart Result Receiver (.NET) - sample requests
### Open in VS Code (REST Client), Rider or Visual Studio and click "Send".

@host = http://127.0.0.1:8200
@token = 

### Health -------------------------------------------------------------------
GET {{host}}/health

### Training event (201 created; resend the identical body for 200 replay) ----
POST {{host}}/v1/results/training
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "event_id": "train_20261013043353_8cef49:300:2:training:candidate_ready:v1",
  "event_type": "training.completed",
  "schema_version": 1,
  "occurred_at": "2026-10-13T04:33:53.120Z",
  "entity_id": "300:2",
  "site_key": "177",
  "upload_id": "upl_20261013_002b9ca1",
  "job_id": "train_20261013043353_8cef49",
  "model_id": "mdl_300_2_20261013035036_c1f270",
  "payload": {
    "status": "candidate_ready",
    "config_hash": "549777393e8a3846",
    "metrics": { "mae": 3.41, "rmse": 5.02, "rows": 18420 },
    "effective_config_at_training": { "horizon_min": 40, "bay_capacity": 120 }
  }
}

### Backtest event - payload.backtest_type is mandatory (422 without it) ------
POST {{host}}/v1/results/backtest
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "event_id": "train_20261013043353_8cef49:300:2:policy_replay:completed:v1",
  "event_type": "backtest.completed",
  "schema_version": 1,
  "occurred_at": "2026-10-13T04:34:30.462Z",
  "entity_id": "300:2",
  "site_key": "177",
  "upload_id": "upl_20261013_002b9ca1",
  "job_id": "train_20261013043353_8cef49",
  "model_id": "mdl_300_2_20261013035036_c1f270",
  "payload": {
    "backtest_type": "policy_replay",
    "report_id": "bt-300_2-20261013-043430-ab12c",
    "status": "completed",
    "config_hash": "549777393e8a3846",
    "frozen_model_config": { "red_model": 25, "amber_model": 35 },
    "effective_operational_config": {
      "red_threshold": 25, "amber_threshold": 35,
      "bay_capacity": 120, "target_stock": 50, "lead_time_min": 10.0
    },
    "metrics": { "alerts": 14, "trips": 7, "carts": 124 },
    "caveat": "simulation estimate, conditional on assumptions"
  }
}

### Calibration event ---------------------------------------------------------
POST {{host}}/v1/results/calibration
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "event_id": "train_20261013043353_8cef49:300:2:calibration:completed:v1",
  "event_type": "calibration.completed",
  "schema_version": 1,
  "occurred_at": "2026-10-13T04:35:01.000Z",
  "entity_id": "300:2",
  "site_key": "177",
  "job_id": "train_20261013043353_8cef49",
  "model_id": "mdl_300_2_20261013035036_c1f270",
  "payload": {
    "calibrator_id": "cal_300_2_20261013043501",
    "status": "completed",
    "scope": "entity",
    "method": "isotonic",
    "metrics": { "brier": 0.081, "ece": 0.019 }
  }
}

